# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public base URL, used to build personal RSVP links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Needed only for platform-admin actions (never exposed to the browser)
SUPABASE_SECRET_KEY=

# Password for the seeded test users (see supabase/seed.sql)
E2E_PASSWORD=
